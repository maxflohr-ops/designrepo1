{
  "name": "bounty-sounds-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bounty Sounds backend — modular monolith (identity, bounties, counting, treasury, notify)",
  "scripts": {
    "build": "tsc",
    "migrate": "tsx src/bin/migrate.ts",
    "dev": "tsx src/bin/server.ts",
    "worker": "tsx src/bin/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
